/* Liquid Glass: numeric material values and colors live in liquid-glass.json. */
QWidget { font-family: "@body-font@"; font-size: 10pt; color: @glass.text@; }
QMainWindow, QDialog, SettingsWindow { background: @glass.base@; }
GameListWidget, QWidget#swLibraryCenter, QWidget#swDetailsBody, QStackedWidget#stack,
QListView#swGameGrid, QTableView#swGameTable, QWidget[glassSurface="true"], QScrollArea#swDetails { background: transparent; border: none; }
QLabel#swHeading { font-family: "@heading-font@"; font-size: 25.5pt; font-weight: 700; }
QLabel#swGameTitle { font-family: "@heading-font@"; font-size: 19.5pt; font-weight: 700; }
QLabel#swMuted, QLabel#swNavTitle, QLabel#swNavCount { color: @glass.secondaryText@; }
QLabel#swSection { color: @glass.labelText@; font-size: 9pt; font-weight: 700; }
QLabel#swPlatform { color: @glass.secondaryText@; font-size: 9pt; font-weight: 700; }
QLabel#swNavTitle { padding-left: 10px; }
QLabel#swStats { background: rgba(0,0,0,@glass.statAlpha255@); border: 1px solid rgba(255,255,255,26); border-radius: @glass.statRadius@px; padding: 12px; }
QLabel#swFilePath { background: rgba(0,0,0,@glass.statAlpha255@); border: 1px solid rgba(255,255,255,26); border-radius: @glass.statRadius@px; padding: 12px; color: @glass.secondaryText@; }
QPushButton, QToolButton { background: rgba(255,255,255,@glass.buttonAlpha255@); border: 1px solid rgba(255,255,255,@glass.borderAlpha255@); border-top-color: rgba(255,255,255,@glass.highlightAlpha255@); border-radius: @glass.pillRadius@px; padding: 8px 12px; min-height: 26px; color: @glass.text@; }
QPushButton:hover, QToolButton:hover { background: rgba(255,255,255,@glass.selectedAlpha255@); border-color: rgba(255,255,255,85); }
QPushButton:pressed, QToolButton:pressed { background: rgba(0,0,0,70); }
QPushButton:focus, QToolButton:focus { border: 2px solid @accent@; }
QPushButton:checked, QToolButton:checked { background: rgba(255,255,255,@glass.selectedAlpha255@); border-color: rgba(255,255,255,65); }
QPushButton#swPrimary, QPushButton:default { background: @button-accent@; border: 1px solid rgba(255,255,255,90); border-top-color: rgba(255,255,255,115); color: white; font-weight: 700; border-radius: 25px; }
QPushButton#swPrimary:hover { border-color: white; }
QPushButton:disabled, QToolButton:disabled { color: #A0A7B8; background: rgba(255,255,255,8); border-color: rgba(255,255,255,20); }
QPushButton#swNav { text-align: left; background: transparent; border-color: transparent; border-radius: @glass.navRadius@px; padding: 10px; }
QPushButton#swNav:checked { background: rgba(255,255,255,@glass.selectedAlpha255@); border: 1px solid rgba(255,255,255,56); border-top-color: rgba(255,255,255,90); }
QPushButton#swNav:hover { background: rgba(255,255,255,22); }
QPushButton#swGameSettings, QPushButton#swFavorite { border-radius: 25px; min-height: 0; padding: 0; }
QPushButton#swFavorite:checked { background: rgba(245,196,81,38); border-color: rgba(245,196,81,120); }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: rgba(0,0,0,56); border: 1px solid rgba(255,255,255,36); border-radius: @glass.pillRadius@px; padding: 8px 12px; min-height: 26px; color: @glass.text@; selection-background-color: @accent@; selection-color: white; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: @accent@; }
QLineEdit#searchText { border-color: transparent; }
QComboBox { combobox-popup: 0; padding-right: 30px; }
QComboBox#filterRegion, QComboBox#swSort { background: rgba(255,255,255,@glass.buttonAlpha255@); border-color: rgba(255,255,255,36); }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 28px; border: none; }
QComboBox::down-arrow { image: url("@resources@/icons/launcher/chevron-down.svg"); width: 16px; height: 16px; }
QLineEdit#searchText, QComboBox#filterRegion, QComboBox#swSort { min-height: 42px; max-height: 42px; padding: 0 12px; }
QComboBox#filterRegion { padding-left: 10px; padding-right: 24px; }
QComboBox#swSort { padding-right: 28px; }
QMenu, QFrame#swSelectorPopup { background: #171925; border: 1px solid rgba(255,255,255,50); border-radius: 18px; padding: 6px; }
QMenu::item { padding: 12px 28px 12px 14px; border-radius: 12px; }
QMenu::item:selected { background: rgba(255,255,255,35); }
QMenu::separator { height: 1px; background: rgba(255,255,255,30); margin: 6px; }
QComboBox QAbstractItemView, QListView#swSelectorList { background: #171925; border: none; padding: 4px; outline: none; selection-background-color: #353345; selection-color: @glass.text@; }
QListView#swSelectorList::item { padding: 6px 12px; margin: 2px 0; border: 1px solid transparent; border-radius: 12px; color: @glass.secondaryText@; }
QListView#swSelectorList::item:hover { background: rgba(255,255,255,20); }
QListView#swSelectorList::item:selected { background: rgba(255,255,255,35); border-color: @accent@; color: @glass.text@; }
QFrame#swViewSwitch { background: rgba(0,0,0,45); border: 1px solid rgba(255,255,255,40); border-radius: 22px; }
QFrame#swViewSwitch QToolButton { min-height: 0; padding: 0; margin: 0; border: 1px solid transparent; border-radius: 18px; background: transparent; }
QFrame#swViewSwitch QToolButton:hover { background: rgba(255,255,255,24); }
QFrame#swViewSwitch QToolButton:checked { background: rgba(255,255,255,41); border-color: rgba(255,255,255,90); }
QFrame#swToolbarDivider { background: rgba(255,255,255,40); border: none; }
QToolButton#swMore { padding: 0; min-height: 0; }
QToolButton::menu-indicator { image: none; width: 0; height: 0; }
QMenuBar, QToolBar { background: #151722; border: none; }
QMenuBar::item { padding: 8px 12px; }
QMenuBar::item:selected { background: rgba(255,255,255,30); }
QListView, QTableView, QTreeView { background: #10121C; alternate-background-color: #151724; border: none; outline: none; selection-background-color: #353345; selection-color: @glass.text@; }
GameListGridListView { background: transparent; selection-background-color: @accent@; }
QTableView::item, QTreeView::item { padding: 10px 6px; border: none; }
QTableView::item:hover, QTreeView::item:hover { background: rgba(255,255,255,18); }
QListWidget#settingsCategory { background: #12141F; border-right: 1px solid rgba(255,255,255,30); }
QListWidget#settingsCategory::item { padding: 10px; min-height: 32px; border-radius: 16px; }
QListWidget#settingsCategory::item:selected { background: rgba(255,255,255,35); color: @glass.text@; }
QHeaderView::section { background: #151724; color: @glass.secondaryText@; border: none; border-bottom: 1px solid rgba(255,255,255,30); padding: 12px 8px; }
QScrollBar:vertical { background: transparent; width: 8px; }
QScrollBar:horizontal { background: transparent; height: 8px; }
QScrollBar::handle { background: rgba(255,255,255,55); border-radius: 4px; min-height: 30px; min-width: 30px; }
QScrollBar::handle:hover { background: rgba(255,255,255,95); }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QSlider { min-height: 44px; }
QSlider::groove:horizontal { height: 4px; background: rgba(255,255,255,35); border-radius: 2px; }
QSlider::sub-page:horizontal { background: @accent@; }
QSlider::handle:horizontal { background: white; width: 16px; margin: -6px 0; border-radius: 8px; }
QTabWidget::pane { border: 1px solid rgba(255,255,255,35); border-radius: 18px; }
QTabBar::tab { padding: 14px 12px; color: @glass.secondaryText@; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: white; border-bottom: 2px solid @accent@; }
QGroupBox { border: 1px solid rgba(255,255,255,35); border-radius: 18px; margin-top: 20px; padding: 16px 8px 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; color: @glass.text@; font-weight: 700; }
QCheckBox, QRadioButton { min-height: 32px; spacing: 10px; }
QCheckBox::indicator, QRadioButton::indicator { width: 20px; height: 20px; background: rgba(255,255,255,16); border: 1px solid rgba(255,255,255,95); border-radius: 7px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: @accent@; border: 2px solid white; }
QCheckBox::indicator:indeterminate { background: #A0A7B8; border: 4px solid #353345; }
QRadioButton::indicator { border-radius: 10px; }
QToolTip { background: #171925; color: white; border: 1px solid rgba(255,255,255,80); padding: 8px; border-radius: 12px; }
QStatusBar { background: @glass.base@; color: @glass.secondaryText@; }
QProgressBar { background: #171925; border: 1px solid rgba(255,255,255,35); text-align: center; }
QProgressBar::chunk { background: @accent@; }
QFrame[frameShape="4"] { background: rgba(255,255,255,30); border: none; max-height: 1px; }

QPushButton#swPrimary { min-height: 32px; max-height: 32px; }
QPushButton#swGameSettings, QPushButton#swFavorite { min-width: 48px; max-width: 48px; min-height: 48px; max-height: 48px; padding: 0; }

/* Height-adaptive preview: all actions stay inside the panel, without scrolling. */
QWidget#swDetailsBody QLabel#swGameTitle { font-size: 17pt; }
QWidget#swDetailsBody QLabel#swStats { padding: 8px 10px; }
QWidget#swDetailsBody QLabel#swFilePath { padding: 8px 10px; }
QLabel#swPreviewFileLabel { color: @glass.labelText@; font-size: 8pt; font-weight: 700; }
QWidget#swDetailsBody[compactPreview="true"] QLabel#swGameTitle { font-size: 15pt; }
QWidget#swDetailsBody[compactPreview="true"] QLabel#swStats { padding: 5px 8px; }
QWidget#swDetailsBody[compactPreview="true"] QLabel#swFilePath { padding: 5px 8px; }
QWidget#swDetailsBody[compactPreview="true"] QLabel#swPreviewInfo { font-size: 9pt; }
QWidget#swDetailsBody[compactPreview="true"] QPushButton#swPrimary { min-height: 26px; max-height: 26px; }
QWidget#swDetailsBody[compactPreview="true"] QPushButton#swGameSettings,
QWidget#swDetailsBody[compactPreview="true"] QPushButton#swFavorite { min-width: 42px; max-width: 42px; min-height: 42px; max-height: 42px; }

QWidget#swDetailsBody QLabel#swFilePath { border-radius: 16px; }
QWidget#swDetailsBody[compactPreview="true"] QLabel#swFilePath { border-radius: 12px; }
QWidget#swDetailsBody[compactPreview="true"] QPushButton#swPrimary,
QWidget#swDetailsBody[compactPreview="true"] QPushButton#swGameSettings,
QWidget#swDetailsBody[compactPreview="true"] QPushButton#swFavorite { border-radius: 22px; }
