+	m_details_path->setObjectName(QStringLiteral("swFilePath"));
+	m_details_path->setWordWrap(false);
+	m_details_path->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Fixed);
+	m_details_path->setTextInteractionFlags(Qt::TextSelectableByMouse);
+	detail_layout->addWidget(m_details_path);
+	auto* file_actions = new QHBoxLayout();
+	auto* copy = new QPushButton(LauncherIcon(QStringLiteral("file-copy-line")), tr("Copiar"), body);
+	auto* folder = new QPushButton(LauncherIcon(QStringLiteral("folder-open-line")), tr("Abrir pasta"), body);
+	copy->setObjectName(QStringLiteral("swPreviewCopy"));
+	folder->setObjectName(QStringLiteral("swPreviewFolder"));
+	file_actions->addWidget(copy);
+	file_actions->addWidget(folder);
+	connect(copy, &QPushButton::clicked, this, [this]() {
+		if (const auto entry = getSelectedEntry(); entry)
+			qApp->clipboard()->setText(QString::fromStdString(entry->path));
+	});
+	connect(folder, &QPushButton::clicked, this, [this]() {
+		if (const auto entry = getSelectedEntry(); entry)
+			QDesktopServices::openUrl(QUrl::fromLocalFile(QFileInfo(QString::fromStdString(entry->path)).absolutePath()));
+	});
+	detail_layout->addLayout(file_actions);
+	detail_layout->addStretch();
+	m_details->setWidget(body);
+	body->setAutoFillBackground(false);
+	shell->addWidget(m_details);
+	m_details->setVisible(width() >= 1350);
+	updateLauncher();
+	updateDetails();
+	SDL_AddEventWatch(&GameListWidget::launcherGamepadEvent, this);
+}
+
+void GameListWidget::setLauncherMenus(const QList<QAction*>& actions)
+{
+	QMenu* menu = m_launcher_menu->menu();
+	for (QAction* action : actions)
+		menu->addAction(action);
+	menu->addSeparator();
+	for (auto* button : {m_ui.viewGridTitles, m_ui.viewFullGridTitles})
+	{
+		auto* action = menu->addAction(button->toolTip());
+		action->setCheckable(true);
+		action->setChecked(button->isChecked());
+		connect(action, &QAction::toggled, button, &QToolButton::setChecked);
+		connect(button, &QToolButton::toggled, action, &QAction::setChecked);
+	}
+	menu->addAction(tr("Atualizar biblioteca"), this, [this]() { refresh(false, true); });
+}
+
+void GameListWidget::selectLauncherPage(int page)
+{
+	m_launcher_page = page;
+	m_sort_model->setLauncherPage(page);
+	if (page == 1)
+		m_table_view->sortByColumn(GameListModel::Column_LastPlayed, Qt::DescendingOrder);
+	m_launcher_heading->setText(m_navigation[page]->toolTip());
+	updateLauncher();
+	if (m_sort_model->rowCount() > 0)
+	{
+		if (isShowingGameList())
+			m_table_view->setCurrentIndex(m_sort_model->index(0, GameListModel::Column_Title));
+		else
+			m_list_view->setCurrentIndex(m_sort_model->index(0, GameListModel::Column_Cover));
+		updateDetails();
+	}
+	else
+		updateDetails();
+}
+
+void GameListWidget::updateLauncher()
+{
+	if (!m_launcher_count)
+		return;
+	const auto lock = GameList::GetLock();
+	int counts[5] = {};
+	counts[0] = static_cast<int>(GameList::GetEntryCount());
+	for (int i = 0; i < counts[0]; i++)
+	{
+		const auto* entry = GameList::GetEntryByIndex(i);
+		if (!entry)
+			continue;
+		counts[1] += entry->last_played_time != 0;
+		counts[2] += entry->is_favorite;
+		counts[3] += LauncherSaveStateCount(*entry) > 0;
+		counts[4] += entry->type == GameList::EntryType::PS2Disc;
+	}
+	for (int i = 0; i < 5; i++)
+	{
+		if (auto* count = m_navigation[i]->findChild<QLabel*>(QStringLiteral("swNavCount")))
+			count->setText(QString::number(counts[i]));
+	}
+	m_launcher_count->setText(tr("%1 jogos · PlayStation 2").arg(m_sort_model->rowCount()));
+}
+
+void GameListWidget::updateDetails()
+{
+	if (!m_details_title)
+		return;
+	const auto entry = getSelectedEntry();
+	const bool valid = entry.has_value();
+	for (auto* button : {m_details_play, m_details_settings, m_details_favorite})
+		button->setEnabled(valid);
+	if (!entry)
+	{
+		if (m_glass_background)
+			m_glass_background->setCover(QString());
+		for (auto* label : m_details->findChildren<QLabel*>())
+			if (label->property("glassPlatform").toBool())
+				label->setText(QStringLiteral("PLAYSTATION 2"));
+		m_details_title->setText(tr("Selecione um jogo"));
+		m_details_source_art = QPixmap();
+		m_details_art->clear();
+		m_details_info->clear();
+		m_details_path->clear();
+		for (auto* label : m_details_stats)
+			label->clear();
+		return;
+	}
+	for (auto* label : m_details->findChildren<QLabel*>())
+		if (label->property("glassPlatform").toBool())
+			label->setText(QStringLiteral("PLAYSTATION 2 · %1").arg(QString::fromUtf8(GameList::RegionToString(entry->region, true))));
+	m_details_title->setText(QString::fromStdString(entry->GetTitle(Host::GetBaseBoolSettingValue("UI", "PreferEnglishGameList", false))));
+	m_details_favorite->setChecked(entry->is_favorite);
+	m_details_favorite->setIcon(LauncherIcon(entry->is_favorite ? QStringLiteral("star-fill") : QStringLiteral("star-line")));
+	// Render the original cover directly: keep its portrait ratio and native detail.
+	// The backing pixmap uses physical pixels so high-DPI screens stay sharp.
+	const QString cover_path = QString::fromStdString(GameList::GetCoverImagePathForEntry(&*entry));
+	if (m_glass_background)
+		m_glass_background->setCover(cover_path);
+	m_details_source_art = QPixmap(cover_path);
+	const QString titles[] = {tr("Tempo jogado"), tr("Última vez"), tr("Compatibilidade"), tr("Save states")};
+	const QString values[] = {
+		entry->total_played_time ? QString::fromStdString(GameList::FormatTimespan(entry->total_played_time)) : tr("Não jogado"),
+		entry->last_played_time ? QString::fromStdString(GameList::FormatTimestamp(entry->last_played_time)) : tr("Nunca"),
+		QString::fromUtf8(GameList::EntryCompatibilityRatingToString(entry->compatibility_rating, true)),
+		QString::number(LauncherSaveStateCount(*entry))};
+	for (int i = 0; i < 4; i++)
+	{
+		const QString color = (i == 2 && entry->compatibility_rating == GameList::CompatibilityRating::Perfect) ? LiquidGlass::Theme::get().color("compatibility", "#7FE8AA").name() : palette().color(QPalette::Text).name();
+		m_details_stats[i]->setText(QStringLiteral("<span style='font-size:9pt;color:#C2C8D6'>%1</span><br><b style='color:%3'>%2</b>")
+				.arg(titles[i].toHtmlEscaped(), values[i].toHtmlEscaped(), color));
+	}
+	m_details_path->setToolTip(QString::fromStdString(entry->path));
+	fitDetails();
+	QTimer::singleShot(0, this, &GameListWidget::fitDetails);
+}
+
+void GameListWidget::renderDetailsCover()
+{
+	const qulonglong source_key = static_cast<qulonglong>(m_details_source_art.cacheKey());
+	const qreal dpr = m_details_art->devicePixelRatioF();
+	if (m_details_art->property("renderedSource").toULongLong() == source_key &&
+		m_details_art->property("renderedSize").toSize() == m_details_art->size() &&
+		m_details_art->property("renderedDpr").toDouble() == dpr)
+		return;
+	m_details_art->setProperty("renderedSource", QVariant::fromValue(source_key));
+	m_details_art->setProperty("renderedSize", m_details_art->size());
+	m_details_art->setProperty("renderedDpr", dpr);
+	const QPixmap& art = m_details_source_art;
+	if (!art.isNull())
+	{
+		const qreal dpr = m_details_art->devicePixelRatioF();
+		QPixmap scaled = art.scaled(m_details_art->size() * dpr, Qt::KeepAspectRatio, Qt::SmoothTransformation);
+		scaled.setDevicePixelRatio(dpr);
+		QPixmap rounded(scaled.size());
+		rounded.setDevicePixelRatio(dpr);
+		rounded.fill(Qt::transparent);
+		QPainter painter(&rounded);
+		painter.setRenderHint(QPainter::Antialiasing);
+		painter.setRenderHint(QPainter::SmoothPixmapTransform);
+		QPainterPath clip;
+		clip.addRoundedRect(QRectF(QPointF(), QSizeF(scaled.deviceIndependentSize())), LiquidGlass::Theme::get().number("coverRadius", 18), LiquidGlass::Theme::get().number("coverRadius", 18));
+		painter.setClipPath(clip);
+		painter.drawPixmap(QPointF(), scaled);
+		m_details_art->setPixmap(rounded);
+	}
+	else
+	{
+		m_details_art->setPixmap(QPixmap());
+		m_details_art->setText(tr("Sem capa disponível"));
+	}
+}
+
+void GameListWidget::fitDetails()
+{
+	if (!m_details || !m_details->widget() || m_fitting_details)
+		return;
+	m_fitting_details = true;
+	QWidget* body = m_details->widget();
+	auto* box = static_cast<QVBoxLayout*>(body->layout());
+	const int available_height = m_details->viewport()->height();
+	const bool compact = available_height < 620;
+	if (!body->property("compactPreview").isValid() || body->property("compactPreview").toBool() != compact)
+	{
+		body->setProperty("compactPreview", compact);
+		for (QWidget* widget : body->findChildren<QWidget*>())
+		{
+			widget->style()->unpolish(widget);
+			widget->style()->polish(widget);
+		}
+		box->setContentsMargins(compact ? 12 : 16, compact ? 12 : 16, compact ? 12 : 16, compact ? 12 : 16);
+		box->setSpacing(compact ? 6 : 8);
+		m_details_play->setFixedHeight(compact ? 44 : 50);
+		m_details_settings->setFixedSize(compact ? 44 : 50, compact ? 44 : 50);
+		m_details_favorite->setFixedSize(compact ? 44 : 50, compact ? 44 : 50);
+	}
+	const QMargins margins = box->contentsMargins();
+	const int width = std::max(80, m_details->viewport()->width() - margins.left() - margins.right());
+	if (const auto entry = getSelectedEntry(); entry)
+	{
+		const QString serial = QString::fromStdString(entry->serial).toHtmlEscaped();
+		const QString size = QString::number(static_cast<double>(entry->total_size) / (1024.0 * 1024.0 * 1024.0), 'f', 2);
+		const QString region = QString::fromUtf8(GameList::RegionToString(entry->region, true)).toHtmlEscaped();
+		m_details_info->setText(compact ? tr("Serial: <b>%1</b> · <b>%2 GB</b>").arg(serial, size) :
+										  tr("Região: <b>%1</b><br>Serial: <b>%2</b><br>Tamanho: <b>%3 GB</b>").arg(region, serial, size));
+		const QString path = QString::fromStdString(entry->path);
+		m_details_path->setText(m_details_path->fontMetrics().elidedText(path, Qt::ElideMiddle, width - 22));
+		m_details_path->setToolTip(path);
+	}
+	int fixed_height = margins.top() + margins.bottom() + std::max(0, box->count() - 1) * box->spacing();
+	for (int i = 0; i < box->count(); i++)
+	{
+		QLayoutItem* item = box->itemAt(i);
+		if (item->widget() == m_details_art || item->spacerItem())
+			continue;
+		const int hint = item->hasHeightForWidth() ? item->heightForWidth(width) : item->sizeHint().height();
+		fixed_height += std::max(item->minimumSize().height(), hint);
+	}
+	const int art_height = std::clamp(available_height - fixed_height - 4, 24,
+		static_cast<int>(LiquidGlass::Theme::get().number("artHeight", 360)));
+	const QSize target(width, art_height);
+	if (m_details_art->size() != target)
+		m_details_art->setFixedSize(target);
+	renderDetailsCover();
+	box->activate();
+	m_fitting_details = false;
+}
+
+
+void GameListWidget::showDetailsDrawer()
+{
+	if (!m_details || m_details_drawer)
+		return;
+	if (width() >= 1350)
+	{
+		m_details->show();
+		m_details_play->setFocus();
+		return;
+	}
+	auto* drawer = new QDialog(this);
+	drawer->setAttribute(Qt::WA_DeleteOnClose);
+	drawer->setWindowTitle(tr("Detalhes do jogo"));
+	m_details_drawer = drawer;
+	auto* box = new QVBoxLayout(drawer);
+	box->setContentsMargins(0, 0, 0, 0);
+	box->addWidget(m_details);
+	auto* close = new QPushButton(tr("Voltar à biblioteca"), drawer);
+	box->addWidget(close);
+	connect(close, &QPushButton::clicked, drawer, &QDialog::accept);
+	connect(drawer, &QDialog::finished, this, [this]() {
+		static_cast<QHBoxLayout*>(layout())->addWidget(m_details);
+		m_details_drawer = nullptr;
+		m_details->setVisible(width() >= 1350);
+	});
+	m_details->show();
+	drawer->resize(380, std::min(800, height()));
+	drawer->show();
+}
