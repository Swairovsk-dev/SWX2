+
+	// Prioritize frequently used sections without removing any existing page.
+	struct Page
+	{
+		QListWidgetItem* item;
+		QWidget* widget;
+		QString help;
+	};
+	std::vector<Page> pages;
+	while (m_ui.settingsCategory->count())
+	{
+		const int index = static_cast<int>(pages.size());
+		QWidget* widget = m_ui.settingsContainer->widget(0);
+		m_ui.settingsContainer->removeWidget(widget);
+		pages.push_back({m_ui.settingsCategory->takeItem(0), widget, m_category_help_text[index]});
+	}
+	const QStringList priority = {tr("Graphics"), tr("Audio"), tr("Controles"), tr("Emulation"), tr("Patches"), tr("Cheats"), tr("Save states")};
+	std::stable_sort(pages.begin(), pages.end(), [&priority](const Page& a, const Page& b) {
+		const int ai = priority.indexOf(a.item->text()), bi = priority.indexOf(b.item->text());
