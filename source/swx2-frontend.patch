+// SPDX-License-Identifier: GPL-3.0+
+// Opt-in integration checks. Run with an isolated -datapath and SWX2_UI_VERIFY=1.
+#pragma once
+
+#include "MainWindow.h"
+#include "LiquidGlass.h"
+#include "QtHost.h"
+#include "GameList/GameListWidget.h"
+#include "Settings/SettingsWindow.h"
+#include "pcsx2/INISettingsInterface.h"
+#include "pcsx2/Host.h"
+#include <QtCore/QTimer>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QFile>
+#include <QtGui/QKeyEvent>
+#include <QtWidgets/QApplication>
+#include <QtWidgets/QLineEdit>
+#include <QtWidgets/QListWidget>
+#include <QtWidgets/QScrollArea>
+#include <QtWidgets/QDialog>
+#include <QtWidgets/QComboBox>
+#include <QtWidgets/QCheckBox>
+#include <QtWidgets/QScrollBar>
+#include "pcsx2/PerformanceMetrics.h"
+#include "common/Path.h"
+
+static void VerifySWX2Launcher(MainWindow* window, const QString& capture)
+{
+	auto report = std::make_shared<QJsonObject>();
+	auto check = [report](const QString& name, bool ok) { report->insert(name, ok); };
+	auto* library = window->findChild<GameListWidget*>();
+	auto* grid = library ? library->findChild<GameListGridListView*>() : nullptr;
+	auto* search = library ? library->findChild<QLineEdit*>(QStringLiteral("searchText")) : nullptr;
+	if (!library || !grid || !search)
+	{
+		qApp->exit(2);
+		return;
+	}
+	const int count = grid->model()->rowCount();
+	check(QStringLiteral("library_has_games"), count > 0);
+	search->setText(QStringLiteral("SWX2_nonexistent_game_7b31"));
+	check(QStringLiteral("search_empty_result"), grid->model()->rowCount() == 0);
+	search->clear();
+	check(QStringLiteral("search_restores_library"), grid->model()->rowCount() == count);
+	grid->setCurrentIndex(grid->model()->index(0, grid->modelColumn()));
+	grid->setFocus();
+	QKeyEvent right(QEvent::KeyPress, Qt::Key_Right, Qt::NoModifier);
+	qApp->sendEvent(grid, &right);
+	check(QStringLiteral("keyboard_grid_navigation"), count < 2 || grid->currentIndex().row() == 1);
+	grid->setCurrentIndex(grid->model()->index(0, grid->modelColumn()));
+	grid->selectionModel()->clearSelection();
+	check(QStringLiteral("current_card_resolves_without_selection_flag"), library->getSelectedEntry().has_value());
+	if (const auto entry = library->getSelectedEntry(); entry)
+		check(QStringLiteral("details_follow_current_card"), library->findChild<QLabel*>(QStringLiteral("swGameTitle"))->text() == QString::fromStdString(entry->title));
+	const auto original = library->getSelectedEntry();
+	if (auto* favorite = library->findChild<QPushButton*>(QStringLiteral("swFavorite")); favorite && original)
+	{
+		favorite->click();
+		const auto changed = library->getSelectedEntry();
+		check(QStringLiteral("favorite_updates_native_data"), changed && changed->is_favorite != original->is_favorite);
+		favorite->click();
+		const auto restored = library->getSelectedEntry();
+		check(QStringLiteral("favorite_restored"), restored && restored->is_favorite == original->is_favorite);
+	}
+	library->showGameList();
+	check(QStringLiteral("list_view"), library->isShowingGameList());
+	library->showGameGrid();
+	check(QStringLiteral("grid_view"), library->isShowingGameGrid());
+	grid->setCurrentIndex(grid->model()->index(0, grid->modelColumn()));
+	check(QStringLiteral("library_capture"), window->grab().save(capture));
+	window->resize(940, 800);
+	QTimer::singleShot(250, window, [window, library, capture, report, check]() {
+		auto* sidebar = library->findChild<QWidget*>(QStringLiteral("swSidebar"));
+		auto* details = library->findChild<QScrollArea*>(QStringLiteral("swDetails"));
+		check(QStringLiteral("compact_sidebar"), sidebar && sidebar->width() == 76);
+		check(QStringLiteral("compact_hides_details"), details && details->isHidden());
+		check(QStringLiteral("narrow_window_fits"), window->width() <= 1000);
+		window->grab().save(capture + QStringLiteral(".compact.png"));
+		if (auto* toggle = library->findChild<QPushButton*>(QStringLiteral("swDetailsToggle")))
+		{
+			toggle->click();
+			const auto drawers = library->findChildren<QDialog*>(QString(), Qt::FindDirectChildrenOnly);
+			check(QStringLiteral("details_drawer_opens"), !drawers.isEmpty() && drawers.front()->isVisible());
+			if (!drawers.isEmpty())
+			{
+				drawers.front()->grab().save(capture + QStringLiteral(".drawer.png"));
+				drawers.front()->accept();
+			}
+		}
+		window->resize(1600, 950);
+		QTimer::singleShot(250, window, [window, library, capture, report, check]() {
+			const auto game = library->getSelectedEntry();
+			if (!game)
+			{
+				qApp->exit(3);
+				return;
+			}
+			SettingsWindow::openGamePropertiesDialog(&*game, game->title, game->serial, game->crc, false, "Graphics");
+			QTimer::singleShot(600, window, [window, capture, report, check]() {
+				SettingsWindow* settings = nullptr;
+				for (QWidget* top : qApp->topLevelWidgets())
+					if (auto* candidate = qobject_cast<SettingsWindow*>(top); candidate && candidate->isPerGameSettings())
+						settings = candidate;
+				check(QStringLiteral("per_game_settings_open"), settings != nullptr);
+				if (settings)
+				{
+					check(QStringLiteral("settings_capture"), settings->grab().save(capture + QStringLiteral(".settings.png")));
+					const auto previous = settings->getFloatValue("EmuCore/GS", "upscale_multiplier", std::nullopt);
+					const float global = Host::GetBaseFloatSettingValue("EmuCore/GS", "upscale_multiplier", 1.0f);
+					auto* card = settings->findChild<QPushButton*>(QStringLiteral("swScale2"));
+					check(QStringLiteral("resolution_card_available"), card && card->isEnabled());
+					if (card && card->isEnabled())
+					{
+						card->click();
+						check(QStringLiteral("resolution_changes_core_setting"), settings->getEffectiveFloatValue("EmuCore/GS", "upscale_multiplier", 1.0f) == 2.0f);
+						check(QStringLiteral("per_game_preserves_global"), Host::GetBaseFloatSettingValue("EmuCore/GS", "upscale_multiplier", 1.0f) == global);
+						auto* ini = static_cast<INISettingsInterface*>(settings->getSettingsInterface());
+						INISettingsInterface persisted(ini->GetFileName());
+						check(QStringLiteral("resolution_persisted_to_disk"), persisted.Load() && persisted.GetFloatValue("EmuCore/GS", "upscale_multiplier", 1.0f) == 2.0f);
+						settings->setFloatSettingValue("EmuCore/GS", "upscale_multiplier", previous);
+					}
+					settings->close();
+				}
+				report->insert(QStringLiteral("physical_gamepad_tested"), false);
+				auto finish = [capture, report]() {
+					QFile result(capture + QStringLiteral(".checks.json"));
+					if (result.open(QIODevice::WriteOnly))
+						result.write(QJsonDocument(*report).toJson());
+					qApp->quit();
+				};
+				if (qEnvironmentVariableIsSet("SWX2_UI_BOOT_VERIFY"))
+				{
+					QMetaObject::invokeMethod(window->findChild<GameListWidget*>(), "entryActivated", Qt::DirectConnection);
+					QTimer::singleShot(14000, window, [window, capture, report, check, finish]() {
+						check(QStringLiteral("game_boots_from_library"), QtHost::IsVMValid());
+						check(QStringLiteral("game_renders_frames"), PerformanceMetrics::GetFrameNumber() > 0);
+						window->grab().save(capture + QStringLiteral(".game.png"));
+						g_emu_thread->shutdownVM(false);
+						QTimer::singleShot(2500, window, finish);
+					});
+				}
+				else
+					finish();
+			});
+		});
+	});
+}
