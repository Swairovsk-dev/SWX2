+		static constexpr int DURATION_MS = 2300;
+
+		SWX2DiscInsert(QWidget* parent, const QString& cover_path, const QString& title)
+			: QWidget(parent)
+			, m_title(title)
+		{
+			if (!cover_path.isEmpty())
+				m_cover = QPixmap(cover_path);
+			setAttribute(Qt::WA_TransparentForMouseEvents, false);
+			setGeometry(parent->rect());
+			connect(&m_timer, &QTimer::timeout, this, [this]() { update(); });
+		}
+
+		void run()
+		{
+			show();
+			raise();
+			m_clock.start();
+			m_timer.start(16);
+			QEventLoop loop;
+			QTimer::singleShot(DURATION_MS, &loop, &QEventLoop::quit);
+			loop.exec();
+			m_timer.stop();
+			hide();
+		}
+
+	protected:
+		static double ease(double x) { return x < 0.5 ? 4 * x * x * x : 1 - std::pow(-2 * x + 2, 3) / 2; }
+		static double seg(double t, double a, double b) { return std::clamp((t - a) / (b - a), 0.0, 1.0); }
+
+		void drawDisc(QPainter& p, QPointF c, double r, double angle)
+		{
+			p.save();
+			p.translate(c);
+			p.rotate(angle);
+
+			QPainterPath outer;
+			outer.addEllipse(QPointF(0, 0), r, r);
+			QPainterPath hole;
+			hole.addEllipse(QPointF(0, 0), r * 0.16, r * 0.16);
+			const QPainterPath disc = outer.subtracted(hole);
+
+			// Silver base.
+			QRadialGradient silver(QPointF(0, 0), r);
+			silver.setColorAt(0.0, QColor(235, 238, 245));
+			silver.setColorAt(0.5, QColor(170, 176, 190));
+			silver.setColorAt(1.0, QColor(210, 214, 225));
+			p.fillPath(disc, silver);
+
+			// Cover printed on the disc.
+			if (!m_cover.isNull())
+			{
+				p.save();
+				QPainterPath label;
+				label.addEllipse(QPointF(0, 0), r * 0.94, r * 0.94);
+				label = label.subtracted(hole);
+				p.setClipPath(label);
+				const QSizeF s = QSizeF(m_cover.size()).scaled(QSizeF(r * 2, r * 2), Qt::KeepAspectRatioByExpanding);
+				p.drawPixmap(QRectF(-s.width() / 2, -s.height() / 2, s.width(), s.height()), m_cover, QRectF(m_cover.rect()));
+				p.restore();
+			}
+			else
+			{
+				p.setPen(QColor(60, 60, 80));
+				QFont f(QStringLiteral("Segoe UI Black"), int(r * 0.22), QFont::Black);
+				p.setFont(f);
+				p.drawText(QRectF(-r, r * 0.25, r * 2, r * 0.4), Qt::AlignCenter, QStringLiteral("PlayStation 2"));
+			}
+
+			// Rainbow sheen.
+			QConicalGradient sheen(QPointF(0, 0), 0);
+			sheen.setColorAt(0.00, QColor(255, 255, 255, 0));
+			sheen.setColorAt(0.10, QColor(0, 212, 255, 70));
+			sheen.setColorAt(0.18, QColor(255, 255, 255, 120));
+			sheen.setColorAt(0.26, QColor(255, 61, 196, 60));
+			sheen.setColorAt(0.40, QColor(255, 255, 255, 0));
+			sheen.setColorAt(0.60, QColor(255, 255, 255, 0));
+			sheen.setColorAt(0.70, QColor(124, 77, 255, 60));
+			sheen.setColorAt(0.78, QColor(255, 255, 255, 110));
+			sheen.setColorAt(0.90, QColor(0, 212, 255, 50));
+			sheen.setColorAt(1.00, QColor(255, 255, 255, 0));
+			p.fillPath(disc, sheen);
+
+			// Hub ring and rim.
+			p.setBrush(Qt::NoBrush);
+			p.setPen(QPen(QColor(255, 255, 255, 180), 2));
+			p.drawEllipse(QPointF(0, 0), r * 0.27, r * 0.27);
+			p.setPen(QPen(QColor(120, 125, 140), 1.5));
+			p.drawEllipse(QPointF(0, 0), r - 0.75, r - 0.75);
+			p.drawEllipse(QPointF(0, 0), r * 0.16, r * 0.16);
+			p.restore();
+		}
+
+		void paintEvent(QPaintEvent*) override
+		{
+			const double t = std::min(1.0, m_clock.elapsed() / double(DURATION_MS));
+			const double W = width(), H = height();
+
+			QPainter p(this);
+			p.setRenderHint(QPainter::Antialiasing);
+			p.setRenderHint(QPainter::SmoothPixmapTransform);
+
+			// Fade in/out of the whole scene.
+			const double alpha = std::min(seg(t, 0.0, 0.08), 1.0 - seg(t, 0.92, 1.0));
+			p.setOpacity(alpha);
+
+			// Backdrop.
+			QRadialGradient bg(QPointF(W / 2, H * 0.45), std::max(W, H) * 0.75);
+			bg.setColorAt(0.0, QColor(12, 22, 48));
+			bg.setColorAt(1.0, QColor(3, 5, 12));
+			p.fillRect(rect(), bg);
+
+			// Console geometry (classic "fat" PS2, front view).
+			const double cw = std::min(W * 0.62, 620.0);
+			const double ch = cw * 0.22;
+			const QRectF body(W / 2 - cw / 2, H * 0.55, cw, ch);
+			const QRectF slot(body.left() + cw * 0.06, body.top() + ch * 0.30, cw * 0.62, ch * 0.16);
+
+			// Floor reflection glow.
+			QRadialGradient floor(QPointF(W / 2, body.bottom() + 10), cw * 0.6);
+			floor.setColorAt(0.0, QColor(31, 107, 255, 80));
+			floor.setColorAt(1.0, QColor(124, 77, 255, 0));
+			p.fillRect(QRectF(0, body.bottom() - 20, W, 80), floor);
+
+			// Tray: slides out (0.05-0.25), waits, slides back (0.55-0.75).
+			const double out = ease(seg(t, 0.05, 0.25)) * (1.0 - ease(seg(t, 0.55, 0.75)));
+			const double trayDepth = ch * 1.15 * out;
+			const QRectF tray(slot.left() + 8, slot.bottom() - 2, slot.width() - 16, trayDepth);
+
+			const double discR = std::min(slot.width() * 0.26, ch * 1.2);
+			const QPointF trayCenter(slot.center().x(), slot.bottom() + trayDepth * 0.55);
+
+			// Disc path: floats in from above (0.15-0.45), rides tray back in (0.55-0.75).
+			const double drop = ease(seg(t, 0.15, 0.45));
+			const QPointF start(W / 2, H * 0.12);
+			QPointF discC(start.x() + (trayCenter.x() - start.x()) * drop, start.y() + (trayCenter.y() - start.y()) * drop);
+			// Seen from the front, the disc flattens as it lies down on the tray.
+			const double flatten = 1.0 - 0.78 * drop;
+			const double spin = m_clock.elapsed() * (0.35 * (1.0 - seg(t, 0.4, 0.5)) + 0.02);
+			const bool discInside = t > 0.75;
+
+			// Body.
+			QPainterPath bodyPath;
+			bodyPath.addRoundedRect(body, 10, 10);
+			QLinearGradient bodyG(body.topLeft(), body.bottomLeft());
+			bodyG.setColorAt(0.0, QColor(44, 44, 54));
+			bodyG.setColorAt(0.5, QColor(22, 22, 28));
+			bodyG.setColorAt(1.0, QColor(10, 10, 14));
+			p.fillPath(bodyPath, bodyG);
+			p.setPen(QPen(QColor(255, 255, 255, 25), 1));
+			for (int i = 1; i < 6; i++)
+			{
+				const double y = body.top() + ch * (0.55 + i * 0.07);
+				p.drawLine(QPointF(body.left() + 12, y), QPointF(body.right() - 12, y));
+			}
+
+			// Disc behind the tray front edge while it rides in.
+			auto paintDisc = [&]() {
+				if (discInside)
+					return;
+				p.save();
+				p.translate(discC);
+				p.scale(1.0, flatten);
+				drawDisc(p, QPointF(0, 0), discR, spin);
+				p.restore();
+			};
+
+			// Slot and tray.
+			p.fillRect(slot, QColor(4, 4, 6));
+			if (trayDepth > 1)
+			{
+				QPainterPath trayPath;
+				trayPath.addRoundedRect(tray, 4, 4);
+				QLinearGradient trayG(tray.topLeft(), tray.bottomLeft());
+				trayG.setColorAt(0.0, QColor(18, 18, 22));
+				trayG.setColorAt(1.0, QColor(36, 36, 44));
+				p.fillPath(trayPath, trayG);
+				p.setPen(QPen(QColor(255, 255, 255, 40), 1));
+				p.drawPath(trayPath);
+			}
+			if (drop > 0.0 && !discInside)
+			{
+				// Clip the disc to everything below the slot's top edge once it is on the tray,
+				// so it looks like it goes into the console.
+				p.save();
+				if (t > 0.55)
+					p.setClipRect(QRectF(0, slot.bottom() - 2, W, H));
+				paintDisc();
+				p.restore();
+			}
+			else
+			{
+				paintDisc();
+			}
+
+			// Logo and power LED.
+			QFont logo(QStringLiteral("Segoe UI"), int(ch * 0.16), QFont::Bold);
+			logo.setItalic(true);
+			p.setFont(logo);
+			p.setPen(QColor(150, 160, 190));
+			p.drawText(QRectF(body.right() - cw * 0.27, slot.top() - 4, cw * 0.24, slot.height() + 8), Qt::AlignCenter,
+				QStringLiteral("SWX2"));
+
+			const bool on = t > 0.78;
+			const QPointF led(body.right() - cw * 0.06, slot.center().y());
+			const QColor ledC = on ? QColor(0, 212, 255) : QColor(230, 60, 60);
+			QRadialGradient ledGlow(led, on ? 26 : 12);
+			ledGlow.setColorAt(0.0, QColor(ledC.red(), ledC.green(), ledC.blue(), 200));
+			ledGlow.setColorAt(1.0, QColor(ledC.red(), ledC.green(), ledC.blue(), 0));
+			p.setPen(Qt::NoPen);
+			p.setBrush(ledGlow);
+			p.drawEllipse(led, 26, 26);
+			p.setBrush(ledC);
+			p.drawEllipse(led, 4, 4);
+
+			p.setBrush(Qt::NoBrush);
+			p.setPen(QPen(QColor(255, 255, 255, 30), 1));
+			p.drawPath(bodyPath);
+
+			// Boot flash.
+			const double flash = seg(t, 0.78, 0.84) * (1.0 - seg(t, 0.84, 0.95));
+			if (flash > 0)
+			{
+				QRadialGradient fl(QPointF(W / 2, H / 2), std::max(W, H) * 0.7);
+				fl.setColorAt(0.0, QColor(255, 255, 255, int(170 * flash)));
+				fl.setColorAt(1.0, QColor(0, 212, 255, 0));
+				p.fillRect(rect(), fl);
+			}
+
+			// Title.
+			QFont tf(QStringLiteral("Segoe UI Semibold"), 15);
+			p.setFont(tf);
+			p.setPen(QColor(236, 235, 255));
+			p.drawText(QRectF(0, body.bottom() + 40, W, 30), Qt::AlignHCenter, m_title);
+			QFont sf(QStringLiteral("Segoe UI"), 10);
+			p.setFont(sf);
+			p.setPen(QColor(157, 151, 214));
+			p.drawText(QRectF(0, body.bottom() + 72, W, 22), Qt::AlignHCenter,
+				on ? QStringLiteral("Iniciando...") : QStringLiteral("Inserindo disco"));
+		}
+
+	private:
+		QPixmap m_cover;
+		QString m_title;
+		QElapsedTimer m_clock;
+		QTimer m_timer;
+	};
