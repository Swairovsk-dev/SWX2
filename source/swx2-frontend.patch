+static void VerifySWX2Preview(MainWindow* window, const QString& capture)
+{
+	auto report = std::make_shared<QJsonObject>();
+	auto* library = window->findChild<GameListWidget*>();
+	auto* grid = library->findChild<GameListGridListView*>();
+	auto* details = library->findChild<QScrollArea*>(QStringLiteral("swDetails"));
+	const int games = grid->model()->rowCount();
+	if (games == 0)
+	{
+		qApp->exit(6);
+		return;
+	}
+	const std::array<int, 4> heights = {540, 720, 900, 1080};
+	auto run = std::make_shared<std::function<void(int)>>();
+	*run = [window, library, grid, details, capture, report, heights, games, run](int step) {
+		if (step >= games * static_cast<int>(heights.size()))
+		{
+			QFile file(capture + QStringLiteral(".checks.json"));
+			if (file.open(QIODevice::WriteOnly))
+				file.write(QJsonDocument(*report).toJson());
+			qApp->quit();
+			return;
+		}
+		const int height = heights[step / games], game = step % games;
+		window->resize(1600, height);
+		grid->setCurrentIndex(grid->model()->index(game, grid->modelColumn()));
+		QTimer::singleShot(250, window, [window, library, grid, details, capture, report, height, game, step, run]() {
+			const QString prefix = QStringLiteral("h%1_game%2_").arg(height).arg(game);
+			const QRect viewport(QPoint(), details->viewport()->size());
+			auto* copy = library->findChild<QPushButton*>(QStringLiteral("swPreviewCopy"));
+			auto* folder = library->findChild<QPushButton*>(QStringLiteral("swPreviewFolder"));
+			auto* cover = library->findChild<QLabel*>(QStringLiteral("swPreviewCover"));
+			report->insert(prefix + QStringLiteral("no_scroll_range"), details->verticalScrollBar()->maximum() == 0);
+			report->insert(prefix + QStringLiteral("body_fits_viewport"), details->widget()->height() <= details->viewport()->height());
+			for (auto* action : {copy, folder})
+			{
+				const QRect bounds(action->mapTo(details->viewport(), QPoint()), action->size());
+				report->insert(prefix + action->objectName() + QStringLiteral("_visible"), viewport.contains(bounds));
+			}
+			const QPixmap image = cover->pixmap();
+			report->insert(prefix + QStringLiteral("portrait_preserved"), !image.isNull() && image.width() < image.height() && image.deviceIndependentSize().height() <= cover->height());
+			report->insert(prefix + QStringLiteral("cover_height"), cover->height());
+			window->grab().save(capture + QStringLiteral(".%1-%2.png").arg(height).arg(game));
+			(*run)(step + 1);
+		});
+	};
+	(*run)(0);
+}
