+// SPDX-License-Identifier: GPL-3.0+
+#pragma once
+
+#include "QtHost.h"
+#include "pcsx2/Host.h"
+#include <QtCore/QFile>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QPointer>
+#include <QtCore/QHash>
+#include <QtCore/QVariantAnimation>
+#include <QtGui/QImage>
+#include <QtGui/QPainter>
+#include <QtGui/QPainterPath>
+#include <QtWidgets/QApplication>
+#include <QtWidgets/QScrollArea>
+#include <algorithm>
+#include <array>
+#include <functional>
+#include <cmath>
+#include <vector>
+
+namespace LiquidGlass
+{
+
+	class Theme
+	{
+	public:
+		static const Theme& get()
+		{
+			static const Theme theme;
+			return theme;
+		}
+		double number(const char* key, double fallback) const { return m_values.value(QLatin1String(key)).toDouble(fallback); }
+		QColor color(const char* key, const char* fallback) const { return QColor(m_values.value(QLatin1String(key)).toString(QLatin1String(fallback))); }
+		QColor buttonAccent(QColor color) const
+		{
+			const auto linear = [](double c) { return c <= 0.04045 ? c / 12.92 : std::pow((c + 0.055) / 1.055, 2.4); };
+			while (0.2126 * linear(color.redF()) + 0.7152 * linear(color.greenF()) + 0.0722 * linear(color.blueF()) > number("buttonMaxLuminance", 0.18))
+				color = color.darker(104);
+			return color;
+		}
+		QString substitute(QString style) const
+		{
+			for (auto it = m_values.begin(); it != m_values.end(); ++it)
+			{
+				style.replace(QStringLiteral("@glass.%1@").arg(it.key()), it->isString() ? it->toString() : QString::number(it->toDouble()));
+				if (it->isDouble())
+					style.replace((QStringLiteral("@glass.%1").arg(it.key()) + QStringLiteral("255@")), QString::number(qRound(it->toDouble() * 255)));
+			}
+			return style;
+		}
+
+	private:
+		Theme()
+		{
+			QFile file(QStringLiteral("%1/styles/liquid-glass.json").arg(QtHost::GetResourcesBasePath()));
+			if (file.open(QIODevice::ReadOnly))
+				m_values = QJsonDocument::fromJson(file.readAll()).object();
+		}
+		QJsonObject m_values;
+	};
+
+	inline QColor dominantColor(const QImage& source)
+	{
+		if (source.isNull())
+			return Theme::get().color("fallbackMood", "#1B2E5C");
+		const QImage image = source.scaled(48, 48, Qt::IgnoreAspectRatio, Qt::SmoothTransformation).convertToFormat(QImage::Format_ARGB32);
+		struct Bucket
+		{
+			double weight = 0, r = 0, g = 0, b = 0;
+		};
+		std::array<Bucket, 36> buckets{};
+		for (int y = 0; y < image.height(); y++)
+			for (int x = 0; x < image.width(); x++)
+			{
+				const QColor color(image.pixel(x, y));
+				const double saturation = color.hsvSaturationF(), value = color.valueF();
+				if (saturation < 0.25 || value < 0.18)
+					continue;
+				const double weight = saturation * saturation * value;
+				auto& bucket = buckets[std::clamp(static_cast<int>(color.hsvHueF() * 36), 0, 35)];
+				bucket.weight += weight;
+				bucket.r += color.redF() * weight;
+				bucket.g += color.greenF() * weight;
+				bucket.b += color.blueF() * weight;
+			}
+		const auto& best = *std::max_element(buckets.begin(), buckets.end(), [](const Bucket& a, const Bucket& b) { return a.weight < b.weight; });
+		if (best.weight <= 0)
+			return Theme::get().color("fallbackMood", "#1B2E5C");
+		const QColor color = QColor::fromRgbF(best.r / best.weight, best.g / best.weight, best.b / best.weight);
+		return QColor::fromHsvF(color.hsvHueF(), std::min(1.0, color.hsvSaturationF() * Theme::get().number("blobSaturation", 1.4)), std::min(0.85, static_cast<double>(color.valueF())));
+	}
+
+	// Linear-time separable box blur, cached per backdrop change, never per animation frame.
+	inline QImage blurImage(QImage image, int radius)
+	{
+		if (radius < 1 || image.isNull())
+			return image;
+		image = image.convertToFormat(QImage::Format_RGB32);
+		QImage temporary(image.size(), QImage::Format_RGB32);
+		const int width = image.width(), height = image.height(), divisor = radius * 2 + 1;
+		for (int pass = 0; pass < 3; pass++)
+		{
+			for (int y = 0; y < height; y++)
+			{
+				const auto* input = reinterpret_cast<const QRgb*>(image.constScanLine(y));
+				auto* output = reinterpret_cast<QRgb*>(temporary.scanLine(y));
+				int r = 0, g = 0, b = 0;
+				for (int i = -radius; i <= radius; i++)
+				{
+					const QRgb c = input[std::clamp(i, 0, width - 1)];
+					r += qRed(c);
+					g += qGreen(c);
+					b += qBlue(c);
+				}
+				for (int x = 0; x < width; x++)
+				{
+					output[x] = qRgb(r / divisor, g / divisor, b / divisor);
+					const QRgb left = input[std::clamp(x - radius, 0, width - 1)], right = input[std::clamp(x + radius + 1, 0, width - 1)];
+					r += qRed(right) - qRed(left);
+					g += qGreen(right) - qGreen(left);
+					b += qBlue(right) - qBlue(left);
+				}
+			}
+			for (int x = 0; x < width; x++)
+			{
+				int r = 0, g = 0, b = 0;
+				for (int i = -radius; i <= radius; i++)
+				{
+					const QRgb c = temporary.pixel(x, std::clamp(i, 0, height - 1));
+					r += qRed(c);
+					g += qGreen(c);
+					b += qBlue(c);
+				}
+				for (int y = 0; y < height; y++)
+				{
+					reinterpret_cast<QRgb*>(image.scanLine(y))[x] = qRgb(r / divisor, g / divisor, b / divisor);
+					const QRgb top = temporary.pixel(x, std::clamp(y - radius, 0, height - 1)), bottom = temporary.pixel(x, std::clamp(y + radius + 1, 0, height - 1));
+					r += qRed(bottom) - qRed(top);
+					g += qGreen(bottom) - qGreen(top);
+					b += qBlue(bottom) - qBlue(top);
+				}
+			}
+		}
+		return image;
+	}
+
+	class Backdrop final : public QWidget
+	{
+	public:
+		explicit Backdrop(QWidget* parent)
+			: QWidget(parent)
+		{
+			setObjectName(QStringLiteral("swGlassBackdrop"));
+			setAttribute(Qt::WA_TransparentForMouseEvents);
+			m_mood = Theme::get().color("fallbackMood", "#1B2E5C");
+			m_accent = qApp->palette().color(QPalette::Highlight);
+			m_animation.setDuration(static_cast<int>(Theme::get().number("transitionMs", 600)));
+			m_animation.setStartValue(0.0);
+			m_animation.setEndValue(1.0);
+			m_animation.setEasingCurve(QEasingCurve::InOutCubic);
+			connect(&m_animation, &QVariantAnimation::valueChanged, this, [this](const QVariant& value) { m_mix = value.toReal(); repaintSurfaces(); });
+		}
+		void setCover(const QString& path)
+		{
+			if (m_cover == path)
+				return;
+			m_cover = path;
+			m_mood = dominantColor(QImage(path));
+			rebuild(true);
+		}
+		void setAccent(const QColor& color)
+		{
+			if (color == m_accent)
+				return;
+			m_accent = color;
+			rebuild(true);
+		}
+		void setSuspended(bool value)
+		{
+			m_suspended = value;
+			if (value)
+			{
+				m_animation.stop();
+				m_mix = 1;
+			}
+			else if (m_dirty)
+			{
+				m_dirty = false;
+				rebuild(false);
+			}
+			repaintSurfaces();
+		}
+		bool suspended() const { return m_suspended; }
+		bool reduced() const { return m_reduced || !m_blur_available; }
+		void setReduced(bool value)
+		{
+			if (value == m_reduced)
+				return;
+			m_reduced = value;
+			m_animation.stop();
+			m_mix = 1;
+			rebuild(false);
+		}
+		void subscribe(QWidget* surface)
+		{
+			m_surfaces.emplace_back(surface);
+		}
+		qreal tintForArea(const QRectF& area, qreal whiteAlpha) const
+		{
+			const QString key = QStringLiteral("%1,%2,%3,%4,%5").arg(qRound(area.x())).arg(qRound(area.y())).arg(qRound(area.width())).arg(qRound(area.height())).arg(qRound(whiteAlpha * 255));
+			if (const auto it = m_tints.constFind(key); it != m_tints.constEnd())
+				return it.value();
+			qreal tint = Theme::get().number("darkTint", 0.18);
+			const auto linear = [](double c) { return c <= 0.04045 ? c / 12.92 : std::pow((c + 0.055) / 1.055, 2.4); };
+			for (; tint < 0.8; tint += 0.04)
+			{
+				double maximum = 0;
+				for (const auto* image : {&m_current, &m_previous})
+					for (int y = 0; y <= 4; y++)
+						for (int x = 0; x <= 4; x++)
+						{
+							if (image->isNull())
+								continue;
+							const int px = std::clamp(qRound((area.x() + area.width() * x / 4) * image->width() / std::max(1, width())), 0, image->width() - 1);
+							const int py = std::clamp(qRound((area.y() + area.height() * y / 4) * image->height() / std::max(1, height())), 0, image->height() - 1);
+							const QColor c(image->pixel(px, py));
+							const auto composite = [tint, whiteAlpha](double v) { return v * (1 - tint) * (1 - whiteAlpha) + whiteAlpha; };
+							maximum = std::max(maximum, 0.2126 * linear(composite(c.redF())) + 0.7152 * linear(composite(c.greenF())) + 0.0722 * linear(composite(c.blueF())));
+						}
+				if (maximum <= Theme::get().number("materialMaxLuminance", 0.085))
+					break;
+			}
+			m_tints.insert(key, tint);
+			return tint;
+		}
+		QColor accent() const { return m_accent; }
+		QColor mood() const { return m_mood; }
+		int cacheGeneration() const { return m_generation; }
+		void draw(QPainter& painter, const QRectF& destination, const QRectF& area, bool blurred) const
+		{
+			const auto draw_frame = [&painter, &destination, &area, this](const QImage& image, qreal opacity) {
+				if (image.isNull())
+					return;
+				painter.setOpacity(opacity);
+				const qreal sx = static_cast<qreal>(image.width()) / std::max(1, width()), sy = static_cast<qreal>(image.height()) / std::max(1, height());
+				painter.drawImage(destination, image, QRectF(area.x() * sx, area.y() * sy, area.width() * sx, area.height() * sy));
+			};
+			painter.save();
+			painter.setRenderHint(QPainter::SmoothPixmapTransform);
+			draw_frame(blurred && !reduced() && !m_suspended ? m_previous_blurred : m_previous, 1);
+			draw_frame(blurred && !reduced() && !m_suspended ? m_blurred : m_current, m_mix);
+			painter.restore();
+		}
+		void repaintSurfaces()
+		{
+			update();
+			for (auto& surface : m_surfaces)
+				if (surface)
+					surface->update();
+		}
+
+	protected:
+		void resizeEvent(QResizeEvent*) override { rebuild(false); }
+		void paintEvent(QPaintEvent*) override
+		{
+			QPainter painter(this);
+			painter.fillRect(rect(), Theme::get().color("base", "#07080D"));
+			draw(painter, rect(), rect(), false);
+			const qreal shadow = Theme::get().number("shadowAlpha", 0.35);
+			for (const auto& surface : m_surfaces)
+			{
+				if (!surface || !surface->isVisible() || !surface->property("glassSurface").toBool() || surface->window() != window())
+					continue;
+				const QPoint pos = mapFromGlobal(surface->mapToGlobal(QPoint()));
+				QRectF bounds(pos, surface->size());
+				bounds.translate(0, 10);
+				painter.setBrush(Qt::NoBrush);
+				for (int spread = 16; spread >= 2; spread -= 2)
+				{
+					QColor color(0, 0, 0);
+					color.setAlphaF(shadow / 10);
+					painter.setPen(QPen(color, 4));
+					painter.drawRoundedRect(bounds.adjusted(-spread, -spread, spread, spread), 28 + spread, 28 + spread);
+				}
+			}
+		}
+
+	private:
+		void rebuild(bool animate)
+		{
+			if (width() <= 0 || height() <= 0)
+				return;
+			if (m_suspended)
+			{
+				m_dirty = true;
+				return;
+			}
+			const auto& theme = Theme::get();
+			m_animation.stop();
+			// Snapshot an interrupted transition once, rather than restarting from a stale color.
+			QImage start = m_current;
+			if (!m_previous.isNull() && m_previous.size() == m_current.size() && m_mix < 1)
+			{
+				start = m_previous.copy();
+				QPainter blend(&start);
+				blend.setOpacity(m_mix);
+				blend.drawImage(0, 0, m_current);
+			}
+			const qreal scale = theme.number("backgroundScale", 0.35);
+			const QSize size = (QSizeF(this->size()) * scale).toSize().expandedTo(QSize(1, 1));
+			m_blur_available = static_cast<qint64>(size.width()) * size.height() <= theme.number("maxCachePixels", 1500000) && !qEnvironmentVariableIsSet("SWX2_DISABLE_GLASS_BLUR");
+			QImage image(size, QImage::Format_RGB32);
+			if (image.isNull())
+			{
+				m_blur_available = false;
+				return;
+			}
+			image.fill(theme.color("base", "#07080D"));
+			QPainter painter(&image);
+			painter.setRenderHint(QPainter::Antialiasing);
+			painter.scale(scale, scale);
+			const auto blob = [&painter, &theme](QPointF center, QColor color, qreal radius) {
+				const qreal alpha = theme.number("blobOpacity", 0.85);
+				QRadialGradient gradient(center, radius);
+				color.setAlphaF(alpha);
+				gradient.setColorAt(0, color);
+				color.setAlphaF(alpha * 0.62);
+				gradient.setColorAt(0.35, color);
+				color.setAlphaF(alpha * 0.17);
+				gradient.setColorAt(0.72, color);
+				color.setAlpha(0);
+				gradient.setColorAt(1, color);
+				painter.fillRect(QRectF(center.x() - radius, center.y() - radius, radius * 2, radius * 2), gradient);
+			};
+			const qreal radius = theme.number("blobRadius", 500);
+			blob(QPointF(width() * 0.15, height() * 0.2), m_mood, radius);
+			blob(QPointF(width() - 220, height() * 0.5), m_accent, radius * 1.04);
+			blob(QPointF(width() * 0.52, height() * 0.98), theme.color("fallbackMood", "#1B2E5C"), radius);
+			painter.end();
+			// Bound the exposed backdrop luminance so unpanelled headings keep 4.5:1 contrast.
+			static const std::array<double, 256> luminance = []() {
+				std::array<double, 256> values{};
+				for (int i = 0; i < 256; i++)
+				{
+					const double c = i / 255.0;
+					values[i] = c <= 0.04045 ? c / 12.92 : std::pow((c + 0.055) / 1.055, 2.4);
+				}
+				return values;
+			}();
+			for (int y = 0; y < image.height(); y++)
+			{
+				auto* line = reinterpret_cast<QRgb*>(image.scanLine(y));
+				for (int x = 0; x < image.width(); x++)
+				{
+					int r = qRed(line[x]), g = qGreen(line[x]), b = qBlue(line[x]);
+					while (0.2126 * luminance[r] + 0.7152 * luminance[g] + 0.0722 * luminance[b] > theme.number("maxBackgroundLuminance", 0.11))
+					{
+						r = static_cast<int>(r * 0.98);
+						g = static_cast<int>(g * 0.98);
+						b = static_cast<int>(b * 0.98);
+					}
+					line[x] = qRgb(r, g, b);
+				}
+			}
+			m_previous = start.size() == size ? start : image;
+			m_current = image;
+			m_previous_blurred = m_blurred.size() == size ? m_blurred : image;
+			m_blurred = reduced() ? image : blurImage(image, std::max(1, qRound(theme.number("blurRadius", 34) * scale)));
+			if (!reduced())
+				for (int y = 0; y < m_blurred.height(); y++)
+				{
+					auto* line = reinterpret_cast<QRgb*>(m_blurred.scanLine(y));
+					for (int x = 0; x < m_blurred.width(); x++)
+					{
+						QColor c(line[x]);
+						c.setHsvF(c.hsvHueF(), std::min(1.0, c.hsvSaturationF() * theme.number("glassSaturation", 1.8)), c.valueF());
+						line[x] = c.rgb();
+					}
+				}
+			m_tints.clear();
+			m_generation++;
+			setProperty("cacheGeneration", m_generation);
+			setProperty("mood", m_mood.name());
+			if (animate && !reduced() && !m_previous.isNull() && isVisible())
+			{
+				m_mix = 0;
+				m_animation.start();
+			}
+			else
+				m_mix = 1;
+			repaintSurfaces();
+		}
+		mutable QHash<QString, qreal> m_tints;
+		QVariantAnimation m_animation;
+		std::vector<QPointer<QWidget>> m_surfaces;
+		QImage m_current, m_previous, m_blurred, m_previous_blurred;
+		QColor m_mood, m_accent;
+		QString m_cover = QStringLiteral("<unselected>");
+		qreal m_mix = 1;
+		bool m_suspended = false, m_reduced = false, m_dirty = false, m_blur_available = true;
+		int m_generation = 0;
+	};
+
+	inline QRectF backdropArea(Backdrop* backdrop, QWidget* surface, const QRectF& local)
+	{
+		const QPoint origin = backdrop->mapFromGlobal(surface->mapToGlobal(QPoint()));
+		if (backdrop->window() != surface->window())
+			return QRectF(backdrop->width() - local.width() - 16, 16, local.width(), local.height());
+		return local.translated(origin);
+	}
+
+	// One cached backdrop sampler/material is shared by panels, scroll panels and card delegates.
+	inline void paintMaterial(QPainter& painter, Backdrop* backdrop, QWidget* surface, const QRectF& rect, qreal radius,
+		qreal opacity = -1, bool selected = false, qreal hover = 0)
+	{
+		const auto& theme = Theme::get();
+		if (opacity < 0)
+			opacity = theme.number("glassAlpha", 0.07);
+		if (selected)
+			opacity = theme.number("selectedAlpha", 0.16);
+		else if (hover > 0)
+			opacity += (theme.number("hoverAlpha", 0.1) - opacity) * hover;
+		painter.save();
+		painter.setRenderHint(QPainter::Antialiasing);
+		QPainterPath path;
+		path.addRoundedRect(rect.adjusted(0.5, 0.5, -0.5, -0.5), radius, radius);
+		painter.setClipPath(path, Qt::IntersectClip);
+		const QRectF area = backdropArea(backdrop, surface, rect);
+		if (!backdrop->reduced())
+		{
+			backdrop->draw(painter, rect, area, true);
+			QColor dark(0, 0, 0);
+			dark.setAlphaF(backdrop->tintForArea(area, opacity));
+			painter.fillPath(path, dark);
+		}
+		else
+			painter.fillPath(path, QColor(13, 15, 24, 248));
+		QColor white(255, 255, 255);
+		white.setAlphaF(backdrop->reduced() ? theme.number("fallbackAlpha", 0.1) : opacity);
+		painter.fillPath(path, white);
+		QLinearGradient gleam(rect.topLeft(), QPointF(rect.left(), rect.top() + 42));
+		white.setAlphaF(theme.number("highlightAlpha", 0.28) * 0.35);
+		gleam.setColorAt(0, white);
+		white.setAlpha(0);
+		gleam.setColorAt(1, white);
+		painter.fillPath(path, gleam);
+		painter.setClipping(false);
+		white.setAlphaF(selected ? theme.number("selectedBorderAlpha", 0.45) : theme.number("borderAlpha", 0.17));
+		painter.setPen(QPen(white, 1));
+		painter.setBrush(Qt::NoBrush);
+		painter.drawPath(path);
+		painter.setClipRect(QRectF(rect.left(), rect.top(), rect.width(), 2));
+		white.setAlphaF(theme.number("highlightAlpha", 0.28));
+		painter.setPen(QPen(white, 1));
+		painter.drawPath(path);
+		painter.restore();
+	}
+
+	class Panel final : public QWidget
+	{
+	public:
+		Panel(Backdrop* backdrop, QWidget* parent, const char* radiusKey = "panelRadius")
+			: QWidget(parent)
+			, m_backdrop(backdrop)
+			, m_radiusKey(radiusKey)
+		{
+			setProperty("glassSurface", true);
+			setAttribute(Qt::WA_StyledBackground, false);
+			backdrop->subscribe(this);
+		}
+
+	protected:
+		void paintEvent(QPaintEvent*) override
+		{
+			if (!m_backdrop)
+				return;
+			QPainter painter(this);
+			paintMaterial(painter, m_backdrop, this, rect(), Theme::get().number(m_radiusKey, 28));
+		}
+
+	private:
+		QPointer<Backdrop> m_backdrop;
+		const char* m_radiusKey;
+	};
+
+	class ScrollPanel final : public QScrollArea
+	{
+	public:
+		ScrollPanel(Backdrop* backdrop, QWidget* parent)
+			: QScrollArea(parent)
+			, m_backdrop(backdrop)
+		{
+			setProperty("glassSurface", true);
+			setFrameShape(QFrame::NoFrame);
+			viewport()->setAutoFillBackground(false);
+			backdrop->subscribe(viewport());
+		}
+
+	protected:
+		void paintEvent(QPaintEvent*) override
+		{
+			if (!m_backdrop)
+				return;
+			QPainter painter(viewport());
+			paintMaterial(painter, m_backdrop, viewport(), viewport()->rect(), Theme::get().number("panelRadius", 28), Theme::get().number("detailAlpha", 0.08));
+		}
+
+	private:
+		QPointer<Backdrop> m_backdrop;
+	};
+
+} // namespace LiquidGlass
diff --git a/swx2-pacote.ps1 b/swx2-pacote.ps1
new file mode 100644
index 000000000..06ab566ca
--- /dev/null
+++ b/swx2-pacote.ps1
@@ -0,0 +1,40 @@
+# Monta a pasta SWX2 pronta para distribuir a partir do build em bin\.
+# Uso: powershell -ExecutionPolicy Bypass -File swx2-pacote.ps1 [-Destino C:\caminho\SWX2]
+param(
+	[string]$Destino = (Join-Path (Split-Path $PSScriptRoot -Parent) "SWX2")
+)
+
+$ErrorActionPreference = "Stop"
+$bin = Join-Path $PSScriptRoot "bin"
+if (-not (Test-Path (Join-Path $bin "SWX2.exe"))) { throw "SWX2.exe nao encontrado em $bin. Compile antes." }
+
+New-Item -ItemType Directory -Force $Destino | Out-Null
+
+# Programa: so o que precisa para rodar (sem .pdb, .lib, .exp, updater).
+# As DLLs ficam ao lado do exe, que e onde o Windows procura.
+robocopy $bin $Destino SWX2.exe qt.conf *.dll /XF *.pdb /NJH /NJS /NP | Out-Null
+foreach ($d in "D3D12", "QtPlugins", "resources", "translations") {
+	robocopy (Join-Path $bin $d) (Join-Path $Destino $d) /MIR /XF *.pdb /NJH /NJS /NP | Out-Null
+}
+robocopy (Join-Path $bin "docs") (Join-Path $Destino "licencas") /MIR /NJH /NJS /NP | Out-Null
+
+# Modo portatil: configuracoes, saves e BIOS ficam dentro da pasta SWX2.
+# portable.txt aponta para a pasta "dados", que guarda tudo menos jogos e BIOS.
+Set-Content -NoNewline -Encoding ascii (Join-Path $Destino "portable.txt") "dados"
+foreach ($d in "jogos", "bios", "dados") { New-Item -ItemType Directory -Force (Join-Path $Destino $d) | Out-Null }
+
+@"
+SWX2 v1.0 - Emulador de PlayStation 2
+
+jogos\   Coloque aqui os jogos (.iso, .chd, .cso, .bin). Aparecem sozinhos na lista.
+bios\    Coloque aqui a BIOS extraida do seu PS2.
+dados\   Configuracoes, saves, capas e estados salvos. Nao apague.
+SWX2.exe Abre o emulador.
+
+Controle: conecte e ele e configurado sozinho na porta 1.
+Capa: clique com o botao direito no jogo > Definir imagem de capa.
+
+Baseado no PCSX2 (GPL v3). Licencas em licencas\.
+"@ | Set-Content -Encoding utf8 (Join-Path $Destino "LEIA-ME.txt")
+
+Write-Host "Pasta SWX2 pronta em $Destino"
diff --git a/tools/swx2/LauncherSmoke.h b/tools/swx2/LauncherSmoke.h
