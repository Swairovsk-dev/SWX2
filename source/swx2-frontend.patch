+static void VerifySWX2Toolbar(MainWindow* window, const QString& capture)
+{
+	auto report = std::make_shared<QJsonObject>();
+	auto check = [report](const QString& key, bool value) { report->insert(key, value); };
+	auto* library = window->findChild<GameListWidget*>();
+	auto* search = library->findChild<QLineEdit*>(QStringLiteral("searchText"));
+	auto* region = library->findChild<QComboBox*>(QStringLiteral("filterRegion"));
+	auto* sort = library->findChild<QComboBox*>(QStringLiteral("swSort"));
+	auto* grid = library->findChild<QToolButton*>(QStringLiteral("viewGameGrid"));
+	auto* list = library->findChild<QToolButton*>(QStringLiteral("viewGameList"));
+	const auto box = [library](QWidget* widget) { return QRect(widget->mapTo(library, QPoint()), widget->size()); };
+	check(QStringLiteral("search_region_sort_aligned"), box(search).top() == box(region).top() && box(region).top() == box(sort).top());
+	check(QStringLiteral("controls_have_equal_height"), search->height() == 44 && region->height() == 44 && sort->height() == 44);
+	check(QStringLiteral("search_expands_without_gaps"), box(region).left() - box(search).right() <= 14);
+	check(QStringLiteral("grid_list_grouped"), box(list).left() - box(grid).right() <= 4 && box(list).top() == box(grid).top());
+	check(QStringLiteral("region_options_preserved"), region->count() == static_cast<int>(GameList::Region::Count) + 1);
+	window->grab().save(capture);
+	region->showPopup();
+	QTimer::singleShot(250, window, [window, library, search, region, sort, capture, report, check, box]() {
+		QWidget* popup = region->view()->window();
+		check(QStringLiteral("region_popup_visible"), popup->isVisible());
+		check(QStringLiteral("region_popup_bounded"), popup->height() <= 420);
+		check(QStringLiteral("region_popup_scrolls"), region->view()->verticalScrollBar()->maximum() > 0);
+		check(QStringLiteral("region_rows_readable"), region->view()->sizeHintForRow(0) >= 36);
+		report->insert(QStringLiteral("region_popup_height"), popup->height());
+		popup->grab().save(capture + QStringLiteral(".regions.png"));
+		region->hidePopup();
+		sort->showPopup();
+		QTimer::singleShot(250, window, [window, library, search, region, sort, capture, report, check, box]() {
+			QWidget* popup = sort->view()->window();
+			check(QStringLiteral("sort_popup_compact"), popup->height() <= 180);
+			popup->grab().save(capture + QStringLiteral(".sort.png"));
+			sort->hidePopup();
+			window->resize(940, 800);
+			QTimer::singleShot(250, window, [window, library, search, region, sort, capture, report, check, box]() {
+				check(QStringLiteral("narrow_search_row_fits"), box(sort).right() <= library->width() && box(search).left() >= 76);
+				check(QStringLiteral("narrow_controls_do_not_overlap"), box(search).right() < box(region).left() && box(region).right() < box(sort).left());
+				window->grab().save(capture + QStringLiteral(".compact.png"));
+				QFile file(capture + QStringLiteral(".checks.json"));
+				if (file.open(QIODevice::WriteOnly))
+					file.write(QJsonDocument(*report).toJson());
+				qApp->quit();
+			});
+		});
+	});
+}
