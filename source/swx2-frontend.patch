+// Observe SDL events without consuming them or replacing the core's input hook.
+// needs proper testing with physical controllers from different vendors.
+bool GameListWidget::launcherGamepadEvent(void* userdata, SDL_Event* event)
+{
+	int key = 0, axis = -1, direction = 0;
+	if (event->type == SDL_EVENT_GAMEPAD_BUTTON_DOWN)
+	{
+		switch (event->gbutton.button)
+		{
+			case SDL_GAMEPAD_BUTTON_DPAD_UP:
+				key = Qt::Key_Up;
+				break;
+			case SDL_GAMEPAD_BUTTON_DPAD_DOWN:
+				key = Qt::Key_Down;
+				break;
+			case SDL_GAMEPAD_BUTTON_DPAD_LEFT:
+				key = Qt::Key_Left;
+				break;
+			case SDL_GAMEPAD_BUTTON_DPAD_RIGHT:
+				key = Qt::Key_Right;
+				break;
+			case SDL_GAMEPAD_BUTTON_SOUTH:
+				key = Qt::Key_Return;
+				break;
+			case SDL_GAMEPAD_BUTTON_EAST:
+				key = Qt::Key_Escape;
+				break;
+			case SDL_GAMEPAD_BUTTON_NORTH:
+				key = Qt::Key_F2;
+				break;
+			case SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER:
+				key = Qt::Key_Tab;
+				break;
+			case SDL_GAMEPAD_BUTTON_LEFT_SHOULDER:
+				key = Qt::Key_Backtab;
+				break;
+			default:
+				return true;
+		}
+	}
+	else if (event->type == SDL_EVENT_GAMEPAD_AXIS_MOTION &&
+			 (event->gaxis.axis == SDL_GAMEPAD_AXIS_LEFTX || event->gaxis.axis == SDL_GAMEPAD_AXIS_LEFTY))
+	{
+		axis = event->gaxis.axis;
+		direction = event->gaxis.value > 18000 ? 1 : (event->gaxis.value < -18000 ? -1 : 0);
+	}
+	else
+		return true;
+	auto* self = static_cast<GameListWidget*>(userdata);
+	QMetaObject::invokeMethod(self, [self, key, axis, direction]() mutable {
+		if (QtHost::IsVMValid() || InputManager::HasHook()) return;
+		QWidget* active = qApp->activeWindow();
+		if (!active || (active != self->window() && active != self->m_details_drawer && !qobject_cast<SettingsWindow*>(active))) return;
+		if (axis >= 0)
+		{
+			int& previous = axis == SDL_GAMEPAD_AXIS_LEFTX ? self->m_gamepad_x : self->m_gamepad_y;
+			if (previous == direction) return;
+			previous = direction;
+			if (direction == 0) return;
+			key = axis == SDL_GAMEPAD_AXIS_LEFTX ? (direction > 0 ? Qt::Key_Right : Qt::Key_Left) : (direction > 0 ? Qt::Key_Down : Qt::Key_Up);
+		}
+		if (key == Qt::Key_F2 && active == self->window()) { self->showDetailsDrawer(); return; }
+		QWidget* target = qApp->focusWidget();
+		if (!target || (active == self->window() && !self->isAncestorOf(target))) target = self->m_list_view;
+		if (key == Qt::Key_Return && qobject_cast<QAbstractButton*>(target)) key = Qt::Key_Space;
+		QKeyEvent press(QEvent::KeyPress, key, Qt::NoModifier), release(QEvent::KeyRelease, key, Qt::NoModifier);
+		qApp->sendEvent(target, &press); qApp->sendEvent(target, &release); }, Qt::QueuedConnection);
+	return true;
+}
