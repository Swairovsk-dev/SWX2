+static void VerifySWX2Glass(MainWindow* window, const QString& capture)
+{
+	auto report = std::make_shared<QJsonObject>();
+	auto check = [report](const QString& name, bool result) { report->insert(name, result); };
+	auto* library = window->findChild<GameListWidget*>();
+	auto* backdrop = dynamic_cast<LiquidGlass::Backdrop*>(library->findChild<QWidget*>(QStringLiteral("swGlassBackdrop")));
+	if (!backdrop)
+	{
+		qApp->exit(5);
+		return;
+	}
+	check(QStringLiteral("backdrop_cached"), backdrop->cacheGeneration() > 0);
+	auto* probe = new LiquidGlass::Panel(backdrop, library);
+	probe->setGeometry(300, 550, 240, 160);
+	probe->show();
+	probe->grab().save(capture + QStringLiteral(".material.png"));
+	check(QStringLiteral("reusable_glass_material"), !probe->grab().isNull());
+	probe->hide();
+	probe->deleteLater();
+	backdrop->setCover(QStringLiteral("%1/covers/SLES-54962.webp").arg(QString::fromStdString(EmuFolders::DataRoot)));
+	const QColor warm = backdrop->mood();
+	backdrop->setCover(QStringLiteral("%1/covers/SLES-52568.webp").arg(QString::fromStdString(EmuFolders::DataRoot)));
+	check(QStringLiteral("cover_changes_ambient_color"), warm != backdrop->mood());
+	const int generation = backdrop->cacheGeneration();
+	QTimer::singleShot(800, window, [window, library, backdrop, capture, report, check, generation]() {
+		check(QStringLiteral("no_blur_rebuild_during_transition"), generation == backdrop->cacheGeneration());
+		backdrop->setSuspended(true);
+		const int frozen = backdrop->cacheGeneration();
+		backdrop->setAccent(backdrop->accent() == QColor("#4C8DFF") ? QColor("#FF8A3D") : QColor("#4C8DFF"));
+		check(QStringLiteral("no_blur_work_during_emulation"), frozen == backdrop->cacheGeneration());
+		backdrop->setSuspended(false);
+		check(QStringLiteral("effects_resume_after_emulation"), backdrop->cacheGeneration() > frozen);
+		backdrop->setReduced(true);
+		check(QStringLiteral("reduced_transparency_fallback"), backdrop->reduced());
+		window->grab().save(capture + QStringLiteral(".reduced.png"));
+		backdrop->setReduced(false);
+		backdrop->setAccent(qApp->palette().color(QPalette::Highlight));
+		window->grab().save(capture);
+		if (auto* settings_action = window->findChild<QAction*>(QStringLiteral("actionSettings")))
+			settings_action->trigger();
+		SettingsWindow* settings = nullptr;
+		for (auto* top : qApp->topLevelWidgets())
+			if (auto* candidate = qobject_cast<SettingsWindow*>(top); candidate && !candidate->isPerGameSettings())
+				settings = candidate;
+		QCheckBox* reduce = settings ? settings->findChild<QCheckBox*>(QStringLiteral("swReduceTransparency")) : nullptr;
+		check(QStringLiteral("reduce_transparency_setting_exists"), reduce != nullptr);
+		const bool old = reduce && reduce->isChecked();
+		if (reduce)
+			reduce->setChecked(true);
+		check(QStringLiteral("reduce_setting_applies_to_material"), reduce && backdrop->reduced());
+		QTimer::singleShot(1300, window, [capture, report, check, reduce, settings, old]() {
+			INISettingsInterface persisted(Path::Combine(EmuFolders::Settings, "PCSX2.ini"));
+			check(QStringLiteral("reduce_preference_persisted"), persisted.Load() && persisted.GetBoolValue("UI", "SWX2ReduceTransparency", false));
+			if (reduce)
+				reduce->setChecked(old);
+			if (settings)
+				settings->close();
+			QFile file(capture + QStringLiteral(".checks.json"));
+			if (file.open(QIODevice::WriteOnly))
+				file.write(QJsonDocument(*report).toJson());
+			qApp->quit();
+		});
+	});
+}
