+	// SWX2: shows "SWX2" wherever the interface text says "PCSX2".
+	// The About dialog keeps the original text, since it credits the PCSX2 project.
+	class SWX2Translator final : public QTranslator
+	{
+	public:
+		SWX2Translator(QTranslator* inner, QObject* parent)
+			: QTranslator(parent)
+			, m_inner(inner)
+		{
+		}
+
+		QString translate(const char* context, const char* source_text, const char* disambiguation, int n) const override
+		{
+			QString result = m_inner ? m_inner->translate(context, source_text, disambiguation, n) : QString();
+			if (context && std::strcmp(context, "AboutDialog") == 0)
+				return result;
+
+			if (result.isEmpty())
+			{
+				if (!source_text || !std::strstr(source_text, "PCSX2"))
+					return result;
+				result = QString::fromUtf8(source_text);
+			}
+
+			if (result.contains(QStringLiteral("PCSX2")))
+				result.replace(QStringLiteral("PCSX2"), QStringLiteral("SWX2"));
+			return result;
+		}
+
+		bool isEmpty() const override { return false; }
+
+	private:
+		QTranslator* m_inner;
+	};
